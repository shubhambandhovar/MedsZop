# ==============================================================================
# MEDSZOP FRONTEND — CLOUD STAGING ENVIRONMENT TEMPLATE (.env.staging.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Supply these variables in your frontend host build configuration (Vercel, Cloudflare, Render).
# 2. In Vite, only variables prefixed with 'VITE_' are exposed to client bundle.
# 3. NEVER put private API secrets, database credentials, or secret keys in this file.
# ==============================================================================

# Backend API Endpoint (Points to Cloud Staging Backend Service)
VITE_API_URL=https://api-staging.medszop.com/api

# Google OAuth Client ID for Client-Side Sign-In
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_GOOGLE_CLIENT_ID.apps.googleusercontent.com

