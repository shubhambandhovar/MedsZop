# ==============================================================================
# MEDSZOP BACKEND — CLOUD STAGING ENVIRONMENT TEMPLATE (.env.staging.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to your secure cloud secrets manager (e.g., Render Environment Variables,
#    Railway Variables, AWS Secrets Manager).
# 2. NEVER commit actual production or staging credentials to Git.
# 3. All staging credentials MUST be isolated from production services.
# ==============================================================================

# Core Runtime Configuration
NODE_ENV=staging
PORT=5000

# Client & Frontend CORS Origins (Whitelist)
# Comma-separated or exact origin URLs permitted to communicate with this API
CLIENT_URL=https://staging.medszop.com
FRONTEND_URL=https://staging.medszop.com

# Database Connection (MongoDB Atlas Dedicated Staging Cluster or Database)
# MUST target a database name containing 'staging' (e.g. medszop_staging)
# Format: mongodb+srv://<username>:<password>@<staging-cluster>.mongodb.net/medszop_staging?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://staging_user:REPLACE_WITH_STAGING_PASSWORD@medszop-staging.qijtc3b.mongodb.net/medszop_staging?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://staging_user:REPLACE_WITH_STAGING_PASSWORD@medszop-staging.qijtc3b.mongodb.net/medszop_staging?retryWrites=true&w=majority

# Distributed Cache & Rate Limiting (Redis Cloud / Upstash / Managed Redis)
# Supports rediss:// for TLS-encrypted connections
# Format: rediss://default:<password>@<host>:<port>
REDIS_URL=rediss://default:REPLACE_WITH_REDIS_PASSWORD@medszop-staging-redis.upstash.io:6379

# Cryptographic & Authentication Secrets
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_HEX_KEY
JWT_EXPIRE=7d
OTP_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_HEX_KEY

# Payment Gateway (Razorpay — STRICT TEST MODE ONLY)
# Obtain from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
# Test keys always begin with 'rzp_test_'
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_TEST_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_TEST_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_TEST_WEBHOOK_SECRET

# AI Health Assistant (Google Gemini API — Staging Credentials)
# Get from Google AI Studio -> API Keys
GEMINI_API_KEY=AIzaSy_REPLACE_WITH_STAGING_GEMINI_API_KEY

# Email Notification Delivery (Resend API or SMTP)
# Preferred: Resend HTTP API (works across Render/Railway free/starter tiers where SMTP ports 465/587 are blocked)
RESEND_API_KEY=re_REPLACE_WITH_RESEND_API_KEY

# Centralized Sender Identity (Defaults to MedsZop <no-reply@medszop.com>)
EMAIL_FROM=no-reply@medszop.com
EMAIL_FROM_NAME=MedsZop

# Fallback SMTP Credentials (Namecheap Private Email or custom SMTP)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=no-reply@medszop.com
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD

# Medical Prescription Storage Provider
# Options: 'local' (with persistent mount disk) or 's3' (AWS S3 with KMS encryption)
STORAGE_PROVIDER=local
# If STORAGE_PROVIDER=s3, supply the following:
AWS_REGION=ap-south-1
AWS_S3_PRESCRIPTION_BUCKET=medszop-staging-prescriptions-private
AWS_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/replace-with-kms-key-id
AWS_ACCESS_KEY_ID=REPLACE_WITH_STAGING_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_AWS_SECRET_KEY

# Image & Asset Uploads (Cloudinary — Staging Cloud)
CLOUDINARY_CLOUD_NAME=medszop-staging
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_SECRET

# Google OAuth Authentication
GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_GOOGLE_CLIENT_ID.apps.googleusercontent.com

